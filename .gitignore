*.db
*.sqlite
*.sqlite3
/data/
/backend/data/

# Regenerable training caches only (large .npz). The trained ONNX model and its
# metadata ARE committed so the hosted/cloned app's AI screening estimate works.
/backend/ai/models/*.npz
/backend/ai/models/* ([0-9]).onnx
/backend/ai/models/* ([0-9]).json


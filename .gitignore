# Large local data assets: every corpus lives under datasets/, never committed.
#   datasets/rsna/train        RSNA training images (12,611) + train-labels.csv
#   datasets/rsna/test         RSNA test images (200) + test-labels.csv
#   datasets/validation        RSNA validation set -- the LOCKED internal test.
#                              Greulich-Pyle months only, not TW3-stage usable.
#   datasets/tw3-research      TW3 source PDFs for the scoring tables
#   datasets/iap-lms-source    IAP 2015 published tables (provenance copy of
#                              backend/growth/data/*_IAP_5_18.csv)
# Paths are overridable per machine: RSNA_VAL_DIR, RSNA_VAL_CSV, RSNA_TRAIN_CSV,
# RSNA_DATA_DIR (see backend/ai/validation/rsna_data.py).
/datasets/

# Pending deletion: the pre-move layout. `archive/boneage-training-dataset` was
# a byte-identical copy of what is now datasets/rsna/train (12,611 files, same
# names, matching hashes). Ignored so a stray `git add -A` cannot commit 9.4 GB
# before it is removed; delete this line once the directory is gone.
/archive/

# Local patient database and stored radiographs (never commit PHI).
*.db
*.sqlite
*.sqlite3
/data/
/backend/data/

# Regenerable training caches only (large .npz). The trained ONNX model and its
# metadata ARE committed so the hosted/cloned app's AI screening estimate works.
/backend/ai/models/*.npz

# Generated diagnostics and preview artifacts.
synthetic_hand_test.png
/growth_curve_qa.html
/growth-chart-*-report.md
/UIUX-critique-report.md
/_chart_preview_*.png
/_iap_preview.png
/boys_who_iap.png

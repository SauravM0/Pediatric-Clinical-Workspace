# No API key is required for the free local baseline.
PORT=8077
BONE_AGE_MAX_IMAGE_DIM=768

# Future hook for a real local trained model file.
# LOCAL_BONE_AGE_MODEL_PATH=C:\path\to\bone-age-model.onnx

# Authentication is OFF by default: the workspace has no sign-in screen, and
# every endpoint is open to anyone who can reach the app (it binds to 127.0.0.1,
# so that means anyone using this computer). Approvals are attributed to
# 'dev-no-auth' rather than to a named clinician.
#
# Uncomment to put session enforcement back. Doing so ALSO requires re-adding a
# way to sign in -- there is no login UI, so an enabled instance would answer
# 401 to every clinical call with nothing on screen to explain it.
# PCW_AUTH_ENABLED=1

# Encryption of patient names at rest. Keep the key OUTSIDE this folder and
# point at it (preferred), or paste it below (weaker: copying the folder then
# copies the key too). Generate: python -m backend.security.crypto
# PCW_ENCRYPTION_KEY_FILE=D:/pcw-secret/pcw.key
# PCW_ENCRYPTION_KEY=

# Extra host names the app may be addressed by (only with PCW_AUTH_ENABLED=1).
# PCW_ALLOWED_HOSTS=clinic-pc.local
